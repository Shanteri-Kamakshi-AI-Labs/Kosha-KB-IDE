{
	"name": "theme-defaults",
	"displayName": "%displayName%",
	"description": "%description%",
	"categories": [
		"Themes"
	],
	"version": "10.0.0",
	"publisher": "vscode",
	"license": "MIT",
	"engines": {
		"vscode": "*"
	},
	"contributes": {
		"themes": [
			{
				"id": "Kosha Dark",
				"label": "Kosha Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/kosha-dark.json"
			},
			{
				"id": "Kosha Light",
				"label": "Kosha Light",
				"uiTheme": "vs",
				"path": "./themes/kosha-light.json"
			}
		],
		"iconThemes": [
			{
				"id": "vs-minimal",
				"label": "%minimalIconThemeLabel%",
				"path": "./fileicons/vs_minimal-icon-theme.json"
			}
		],
		"configurationDefaults": {
			"window.autoDetectColorScheme": true,
			"workbench.colorTheme": "Kosha Dark",
			"workbench.preferredDarkColorTheme": "Kosha Dark",
			"workbench.preferredLightColorTheme": "Kosha Light",
			"workbench.preferredHighContrastColorTheme": "Kosha Dark",
			"workbench.preferredHighContrastLightColorTheme": "Kosha Light",
			"chat.disableAIFeatures": true
		}
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/microsoft/vscode.git"
	}
}
